<svg xmlns="http://www.w3.org/2000/svg" width="256" height="256" viewBox="0 0 256 256">
  <defs>
    <linearGradient id="iconGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="256" height="256" rx="32" fill="url(#iconGrad)"/>
  
  <!-- AI Symbol -->
  <g transform="translate(64, 64)">
    <circle cx="64" cy="64" r="56" fill="white" opacity="0.15"/>
    <circle cx="64" cy="64" r="48" fill="none" stroke="white" stroke-width="4"/>
    
    <!-- Neural network nodes -->
    <circle cx="64" cy="32" r="8" fill="white"/>
    <circle cx="32" cy="64" r="8" fill="white"/>
    <circle cx="96" cy="64" r="8" fill="white"/>
    <circle cx="48" cy="96" r="8" fill="white"/>
    <circle cx="80" cy="96" r="8" fill="white"/>
    <circle cx="64" cy="64" r="10" fill="white"/>
    
    <!-- Connection lines -->
    <line x1="64" y1="32" x2="64" y2="64" stroke="white" stroke-width="2"/>
    <line x1="32" y1="64" x2="64" y2="64" stroke="white" stroke-width="2"/>
    <line x1="96" y1="64" x2="64" y2="64" stroke="white" stroke-width="2"/>
    <line x1="64" y1="64" x2="48" y2="96" stroke="white" stroke-width="2"/>
    <line x1="64" y1="64" x2="80" y2="96" stroke="white" stroke-width="2"/>
  </g>
  
  <!-- Text -->
  <text x="128" y="200" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="white" text-anchor="middle">ALPHANETIX</text>
  <text x="128" y="228" font-family="monospace" font-size="16" fill="white" text-anchor="middle" opacity="0.9">AI Code Assistant</text>
</svg>
